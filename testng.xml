<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CrossBrowser">
    <test name="Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.GUIElementsTests"/>
            <class name="tests.AlertTests"/>
            <class name="tests.DoubleClickTests"/>
            <class name="tests.DragDropTests"/>
            <class name="tests.FileUploadTests"/>
            <class name="tests.LinksLabelsTests"/>
            <class name="tests.MouseHoverTests"/>
            <class name="tests.NewTabTests"/>
            
        </classes>
    </test>

    <test name="Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="tests.GUIElementsTests"/>
            <class name="tests.AlertTests"/>
            <class name="tests.DoubleClickTests"/>
            <class name="tests.DragDropTests"/>
            <class name="tests.FileUploadTests"/>
            <class name="tests.LinksLabelsTests"/>
            <class name="tests.MouseHoverTests"/>
            <class name="tests.NewTabTests"/>
        </classes>
    </test>
</suite>
